<UserControl x:Class="AppControl_Canary_File.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AppControl_Canary_File"
             mc:Ignorable="d" Height="65" Width="320">
    <Grid Background="DarkGray">
        <Label Content="She's Dead, Jim" HorizontalAlignment="Left" VerticalAlignment="Top" Width="320" Background="DarkSlateBlue" Foreground="White" HorizontalContentAlignment="Left" FontSize="8" FontStyle="Italic" Grid.ColumnSpan="2"/>

        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" FontWeight="Thin" Margin="0,20,0,0">
            If you can read this, your app control is not working.
        </TextBlock>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="8" FontWeight="Thin" Margin="0,50,0,0">
            Or you've allowed this app, which defeats the purpose of having it.
        </TextBlock>
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="8" FontWeight="Thin" Margin="245,47,0,0" Height="15" Width="65" >
            Dismiss
        </Button>
    </Grid>
</UserControl>
