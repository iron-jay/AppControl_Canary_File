<Window x:Class="AppControl_Canary_File.MessBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AppControl_Canary_File"
        Height="180" Width="450"
        Title="App Control Canary Exe"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <Grid Background="DarkGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Content="She's Dead, Jim"
               Background="DarkSlateBlue"
               Foreground="White"
               FontSize="12"
               FontStyle="Italic"
               HorizontalContentAlignment="Left"
               MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="If you can read this, your app control isn't working."
                       FontSize="18" FontWeight="Thin" TextWrapping="Wrap"/>
            <TextBlock Text="Or you've allowed this app, which defeats the purpose of having it..."
                       FontSize="13" FontWeight="Thin" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <Button Grid.Row="2"
                Content="I'll go and fix it"
                HorizontalAlignment="Right"
                FontSize="12" FontWeight="Thin"
                Height="24" Width="90"
                Margin="0,0,10,10"
                Click="Dismiss_Click"/>
    </Grid>
</Window>