<Window x:Class="AppControl_Canary_File.MessBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AppControl_Canary_File"
        Width="620"
        Title="App Control Canary Exe"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid Background="DarkGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Content="She's Dead, Jim"
               Background="DarkSlateBlue"
               Foreground="White"
               FontSize="12"
               FontStyle="Italic"
               HorizontalContentAlignment="Left"
               MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

        <StackPanel Grid.Row="1" Margin="10,10,10,0">
            <TextBlock Text="If you can read this, your app control isn't working."
                       FontSize="18" FontWeight="Thin" TextWrapping="Wrap"/>
            <TextBlock Text="Or you've allowed this app, which defeats the purpose of having it..."
                       FontSize="13" FontWeight="Thin" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Verdict banner. Colour and text are set in code-behind from the report. -->
        <Border Grid.Row="2" x:Name="VerdictBanner" Margin="10,12,10,0" Padding="8,6">
            <TextBlock x:Name="VerdictText"
                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="White"/>
        </Border>

        <ScrollViewer Grid.Row="3" MaxHeight="260" Margin="10,10,10,0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DetailRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                       FontSize="11" FontWeight="SemiBold"
                                       TextWrapping="Wrap" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                       FontSize="11" FontFamily="Consolas"
                                       TextWrapping="Wrap" VerticalAlignment="Top"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,10,10">
            <Button x:Name="CopyButton"
                    Content="Copy details"
                    FontSize="12" FontWeight="Thin"
                    Height="24" Width="90" Margin="0,0,8,0"
                    Click="Copy_Click"/>
            <Button Content="I'll go and fix it"
                    FontSize="12" FontWeight="Thin"
                    Height="24" Width="90"
                    IsDefault="True" IsCancel="True"
                    Click="Dismiss_Click"/>
        </StackPanel>
    </Grid>
</Window>
